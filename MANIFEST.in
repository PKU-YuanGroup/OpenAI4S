# Ship the default conda env specs and the setup wrapper in the sdist so
# `openai4s setup` (and scripts/setup_envs.sh) work from a source distribution.
include envs/*.yml
include CODE_OF_CONDUCT.md
include SECURITY.md
include scripts/setup_envs.sh
include scripts/*.py
# The bundle verifiers ride along in scripts/*.py and read this manifest to
# decide what the science stack should contain; without it they abort on a
# missing file rather than reporting anything about the artifact.
include scripts/bundled_packages.txt
recursive-include docs *.md
recursive-include skills *.R *.Rmd *.aln *.csv *.cwl *.fasta *.fastq *.gb *.html *.ini *.json *.lock *.md *.nf *.py *.qmd *.sh *.toml *.wdl *.yml LICENSE rnaseq_snakefile
recursive-include workflows *.json
recursive-include openai4s/compute/templates *.tmpl
recursive-include openai4s/kernel *.R
recursive-include openai4s/server/webui *.css *.gif *.html *.js *.woff2
global-exclude *.py[cod]
global-exclude __pycache__
