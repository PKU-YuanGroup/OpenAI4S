# The `engines` range in package.json is Vitest 5's supported Node range, and
# npm only *warns* about it by default -- an install on an unsupported runtime
# succeeds, the warning scrolls past, and the failure surfaces later as an
# unexplained vitest or vite error with nothing pointing back at Node. Refuse
# the install instead, so the floor this repository documents in package.json,
# README.md, README_zh.md and CLAUDE.md is a mechanism rather than a note.
#
# CI pins `node-version: "22"`, which resolves to the newest 22.x and satisfies
# the range. If you are outside it, switch Node; do not relax this.
engine-strict=true
